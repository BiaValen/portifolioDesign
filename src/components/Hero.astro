---
import Orbs from './Orbs.astro';
import { t, type Lang } from '../i18n/strings';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<section class="hero tone" data-tone="light">
  <Orbs set="hero" />
  <div class="wrap hero-inner">
    <h1 class="hero-name">{site.name}</h1>
    <p class="hero-role">{site.role[lang]}</p>
    <p class="hero-lead">{s.hero.lead}</p>
    <div class="hero-ctas">
      <a class="btn" href="#portfolio">{s.hero.primary}</a>
      <a class="btn btn--ghost" href="#contato">{s.hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 88svh;
    display: grid;
    align-items: end;
    padding-block: 140px clamp(64px, 9vw, 120px);
    overflow: clip;
  }

  .hero-inner {
    display: grid;
    gap: 20px;
  }

  .hero-name {
    font-size: clamp(3.5rem, 1.6rem + 9vw, 10.5rem);
    font-weight: 200;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero-role {
    color: var(--accent);
    font-size: var(--step-2);
    font-weight: 350;
  }

  .hero-lead {
    max-width: 36rem;
    color: var(--fg-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
  }

  @media (max-width: 560px) {
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>

---
import { t, type Lang } from '../i18n/strings';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const s = t(lang);
---

<footer class="footer tone" data-tone="dark">
  <div class="wrap f-row">
    <p>© {new Date().getFullYear()} {site.name}. {s.footer.rights}</p>
    <ul class="f-links">
      <li><a class="link" href="#top">{s.footer.top}</a></li>
      <li><a class="link" href={alternate} lang={lang === 'pt' ? 'en' : 'pt-BR'}>{s.nav.otherLang}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: 32px 40px;
    border-top: 1px solid var(--line);
  }

  .f-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
    color: var(--fg-soft);
    font-size: 0.92rem;
  }

  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
</style>
